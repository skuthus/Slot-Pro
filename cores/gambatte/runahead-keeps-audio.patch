+/* Run-ahead rolls the core back every frame. A frontend that reports
+ * RETRO_ENVIRONMENT_GET_AUDIO_VIDEO_ENABLE marks the frames it will throw
+ * away with the audio bit clear, and the saves and loads that only serve
+ * run-ahead with bit 2. Those frames skip the resampler, and those loads
+ * keep the resampler, frame pacing and frame blending on the real timeline
+ * instead of resetting them, which would pop the audio every frame. */
+static uint64_t runahead_samples_count = 0;
+static uint64_t runahead_frames_count  = 0;
